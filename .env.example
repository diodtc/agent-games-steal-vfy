# Local dev / test. Never commit a real .env.
PORT=8787
# HMAC secret from the Agent Games dashboard ("Rotate Secret"). Dummy is fine for local tests.
AGENT_GAMES_HMAC_SECRET=test-secret-for-local-only
# Strategy: 8 threshold params. Default: always EXTRACT 10.
STEAL_VFY_PARAMS=10,0,0,0,0,0,0,0
# Blinding salt for the Poseidon commitment. MUST match the salt used to
# compute STEAL_VFY_COMMITMENT. Generate a fresh random one for production.
STEAL_VFY_SALT=322748575781115448660733098535191849917
# Poseidon commitment hash (decimal) of [...params, salt].
# Register the HEX form in the dashboard before the next round pairs.
STEAL_VFY_COMMITMENT=8834646723960147752131498285094526492578241027194476319113712693899723057678
# Optional: Kurier mainnet API key for the on-chain audit pointer.
KURIER_API_KEY=
